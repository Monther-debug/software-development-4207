  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Fees",
      "item": [
        {
          "name": "List Fees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fees"
              ]
            }
          }
        },
        {
          "name": "Create Fee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": {{schoolId}},\n  \"grade_id\": {{gradeId}},\n  \"name\": \"Tuition\",\n  \"code\": \"TUITION\",\n  \"amount\": 500.00,\n  \"currency\": \"USD\",\n  \"frequency\": \"term\",\n  \"status\": \"active\",\n  \"due_date\": \"{{todayPlus30}}\",\n  \"description\": \"Term tuition fee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fees"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('feeId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Show Fee",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/fees/{{feeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fees",
                "{{feeId}}"
              ]
            }
          }
        },
        {
          "name": "Update Fee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 600.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fees/{{feeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fees",
                "{{feeId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Fee",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/fees/{{feeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fees",
                "{{feeId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "List Schools",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/schools" }
        },
        {
          "name": "Create School",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central High\",\n  \"address\": \"123 Main St\",\n  \"status\": \"active\",\n  \"type\": \"public\",\n  \"level\": \"secondary\"\n}"
            },
            "url": "{{baseUrl}}/api/schools"
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Created', function () { pm.response.to.have.status(201); });",
                "let json = pm.response.json(); pm.collectionVariables.set('schoolId', json.id);"
              ] }
            }
          ]
        },
        {
          "name": "Show School",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/schools/{{schoolId}}" }
        },
        {
          "name": "Update School",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Central High Updated\"\n}"
            },
            "url": "{{baseUrl}}/api/schools/{{schoolId}}"
          }
        },
        {
          "name": "Delete School",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/schools/{{schoolId}}" }
        },
        {
            "name": "School Teachers",
            "item": [
                {
                    "name": "List School Teachers",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/schools/{{schoolId}}/teachers"
                    }
                },
                {
                    "name": "Assign Teacher to School",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"teacher_id\": {{teacherId}},\n  \"grade_id\": {{gradeId}}\n}"
                        },
                        "url": "{{baseUrl}}/api/schools/{{schoolId}}/teachers"
                    }
                },
                {
                    "name": "Show School Teacher",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/schools/{{schoolId}}/teachers/{{teacherId}}"
                    }
                },
                {
                    "name": "Update School Teacher",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"grade_id\": {{gradeId2}}\n}"
                        },
                        "url": "{{baseUrl}}/api/schools/{{schoolId}}/teachers/{{teacherId}}"
                    }
                },
                {
                    "name": "Detach Teacher from School",
                    "request": {
                        "method": "DELETE",
                        "url": "{{baseUrl}}/api/schools/{{schoolId}}/teachers/{{teacherId}}"
                    }
                }
            ]
        }
      ]
    },
